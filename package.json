{
  "name": "cell",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:cf": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-check.ts",
    "arena": "node scripts/arena.ts",
    "autoplay": "node scripts/autoplay.ts",
    "record": "node scripts/record.ts",
    "cut": "node scripts/cut.ts",
    "bench": "node scripts/bench.ts",
    "e2e": "playwright test",
    "e2e:engines": "E2E_ENGINES=1 playwright test --project engines",
    "flags": "node scripts/flags-atlas.ts",
    "p3p2": "node scripts/p3p2.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "flag-icons": "^7.5.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.137.0"
  },
  "dependencies": {
    "@p3p2/client": "^0.1.1"
  }
}
